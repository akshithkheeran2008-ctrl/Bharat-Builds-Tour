# AquaGen Environment Configuration
# Duplicate this file as .env to connect the frontend to your AWS Serverless API Gateway

# Leave empty for offline In-Browser Demo Mode (default)
# Set to your AWS API Gateway Prod Stage URL when deployed via AWS SAM
VITE_API_URL=https://abc123xyz.execute-api.us-east-1.amazonaws.com/Prod

# Target AWS Region for backend deployment
AWS_REGION=us-east-1
